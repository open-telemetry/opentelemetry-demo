# Copy to oncall/.env (gitignored) and fill in. Process env vars override this file.
# Never edit the repo-root .env: it is upstream demo config.

# --- Telemetry endpoints (leave empty to auto-discover via `docker compose port`) ---
# Prometheus base URL, e.g. http://localhost:9090
PROM_URL=
# Jaeger UI/API base URL (random host port for container port 16686)
JAEGER_URL=
# OpenSearch base URL (random host port for container port 9200)
OPENSEARCH_URL=
# OpenSearch index holding demo logs; discover with GET /_cat/indices?v
OPENSEARCH_LOG_INDEX=
# Comma-separated compose files used for endpoint discovery
COMPOSE_FILES=compose.yaml,compose.observability.yaml

# --- Telemetry backend ---
# live = query the running demo; offline = replay recorded fixtures
TELEMETRY_BACKEND=live
# Directory with offline fixtures/bundles (used when TELEMETRY_BACKEND=offline)
OFFLINE_DIR=

# --- LLM ---
# LLM provider name, e.g. anthropic
LLM_PROVIDER=
# Model id for that provider
LLM_MODEL=
# API key for the provider (never commit a real key)
LLM_API_KEY=
# Optional custom base URL for the provider API
LLM_BASE_URL=
# Max output tokens per LLM call
LLM_MAX_TOKENS=4096

# --- Agent loop ---
# Max investigation steps before the agent must conclude or escalate
MAX_STEPS=12
# Minimum confidence (0-1) to propose an action instead of escalating
CONFIDENCE_MIN=0.7
# Directory for run logs (gitignored)
RUNS_DIR=runs

# --- Safety and action ---
# Organisers' Action API base URL (the only way the agent may change the demo)
ACTION_API_URL=
# true = never execute actions, only show what would happen
DRY_RUN=true
# If this file exists, all actions are blocked
KILL_SWITCH_FILE=.killswitch
# Seconds to watch telemetry after an action to confirm recovery
VERIFY_WINDOW_S=120

# --- Alert detector ---
# Error rate (0-1) above which a service raises an alert
ALERT_ERROR_RATE=0.05
# p95 latency in milliseconds above which a service raises an alert
ALERT_P95_MS=1000
# Seconds between detector polls
ALERT_POLL_S=15

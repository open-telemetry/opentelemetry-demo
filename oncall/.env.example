# Copy to oncall/.env (gitignored) and fill in. Process env vars override this file.
# Never edit the repo-root .env: it is upstream demo config.

# --- Telemetry endpoints ---
# Leave empty to auto-discover the published port of the compose project's
# container; if that fails: Prometheus http://127.0.0.1:9090, Jaeger
# http://127.0.0.1:8080/jaeger/ui, OpenSearch none.
# Prometheus base URL, e.g. http://localhost:9090
PROM_URL=
# Jaeger UI base URL including /jaeger/ui (the v3 API lives under it)
JAEGER_URL=
# OpenSearch base URL (random host port for container port 9200)
OPENSEARCH_URL=
# OpenSearch index pattern holding demo logs (empty = otel-logs-*)
OPENSEARCH_LOG_INDEX=
# Compose project of the running demo; Docker lookups filter on its label,
# so the agent works from any folder
COMPOSE_PROJECT_NAME=opentelemetry-demo

# --- Telemetry backend ---
# live = query the running demo; offline = replay recorded fixtures
TELEMETRY_BACKEND=live
# Directory with offline fixtures/bundles (used when TELEMETRY_BACKEND=offline)
OFFLINE_DIR=

# --- LLM ---
# LLM provider name, e.g. anthropic
LLM_PROVIDER=
# Model id for that provider
LLM_MODEL=
# API key for the provider (never commit a real key)
LLM_API_KEY=
# Optional custom base URL for the provider API
LLM_BASE_URL=
# Optional fallback chain, tried in order; an entry whose DAILY quota is used up
# is skipped for the rest of the process. Format: provider:model:KEY_ENV_NAME,...
# where KEY_ENV_NAME names another variable in this file holding the API key.
# Empty = use LLM_PROVIDER / LLM_MODEL / LLM_API_KEY only.
# e.g. groq:openai/gpt-oss-120b:GROQ_KEY_1,groq:openai/gpt-oss-20b:GROQ_KEY_2
LLM_FALLBACKS=
# Max output tokens per LLM call
LLM_MAX_TOKENS=1500
# Max estimated prompt tokens per LLM call; older tool results are compacted to fit
# (6000 suits the Groq free tier, which allows 8000 tokens per minute)
LLM_MAX_PROMPT_TOKENS=6000

# --- Agent loop ---
# Max investigation steps before the agent must conclude or escalate
MAX_STEPS=8
# Minimum confidence (0-1) to propose an action instead of escalating
CONFIDENCE_MIN=0.7
# Directory for run logs (gitignored)
RUNS_DIR=runs

# --- Safety and action ---
# Organisers' Action API base URL (the only way the agent may change the demo)
ACTION_API_URL=
# true = never execute actions, only show what would happen
DRY_RUN=true
# If this file exists, all actions are blocked
KILL_SWITCH_FILE=.killswitch
# Seconds to watch telemetry after an action to confirm recovery
VERIFY_WINDOW_S=120

# --- Alert detector ---
# Error rate (0-1) above which a service raises an alert
ALERT_ERROR_RATE=0.05
# p95 latency in milliseconds above which a service raises an alert
ALERT_P95_MS=1000
# Seconds between detector polls
ALERT_POLL_S=15

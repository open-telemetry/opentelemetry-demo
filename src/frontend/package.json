{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--require ./utils/telemetry/Instrumentation.js' next dev",
    "build": "next build",
    "start": "node --require ./Instrumentation.js server.js",
    "lint": "next lint",
    "cy:open": "cypress open",
    "grpc:generate": "mkdir -p ./protos && protoc -I ./pb  --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_opt=esModuleInterop=true --ts_proto_out=./protos --ts_proto_opt=outputServices=grpc-js demo.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@grpc/grpc-js": "1.14.6",
    "@openfeature/flagd-provider": "0.18.0",
    "@openfeature/flagd-web-provider": "0.8.0",
    "@openfeature/react-sdk": "1.4.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/auto-instrumentations-web": "0.69.0",
    "@opentelemetry/context-zone": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/opentelemetry-browser-detector": "0.300.0",
    "@opentelemetry/resource-detector-alibaba-cloud": "0.39.0",
    "@opentelemetry/resource-detector-aws": "3.0.0",
    "@opentelemetry/resource-detector-container": "0.9.0",
    "@opentelemetry/resource-detector-gcp": "0.59.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@tanstack/react-query": "5.105.0",
    "cookies-next": "6.1.1",
    "currency-symbol-map": "5.1.0",
    "dotenv": "18.0.9",
    "dotenv-expand": "1000.0.0",
    "next": "16.4.3",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "styled-components": "6.6.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "cypress": "16.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "ts-proto": "2.18.3",
    "typescript": "6.0.3"
  }
}

{
  "kind": "Dashboard",
  "metadata": {
    "name": "demo",
    "project": "opentelemetry-demo"
  },
  "spec": {
    "display": {
      "name": "Demo Dashboard"
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "service",
          "display": {
            "name": "Service",
            "hidden": false
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "service_name",
              "matchers": [
                "traces_span_metrics_calls_total"
              ]
            }
          },
          "defaultValue": [
            "frontend"
          ]
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "display": {
            "name": "Trace ID",
            "description": "Set automatically (together with Service=All) when jumping here from a metric exemplar. Filters logs to this trace ID in addition to whatever Service value is currently selected.",
            "hidden": false
          },
          "value": "",
          "name": "traceId"
        }
      }
    ],
    "panels": {
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {},
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This dashboard shows RED metrics for the selected service, as generated by the spanmetrics connector in the OpenTelemetry Collector.\nIf the selected service emits logs, the logs will also be displayed.\nCustom metrics generated by some services are also displayed. \n<br/>\nChart panels may require 5 minutes after the Demo is started before rendering data."
            }
          }
        }
      },
      "1_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests Rate by Span Name"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "requests/sec"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "query": "sum by (span_name) (rate(traces_span_metrics_duration_milliseconds_count{service_name=~\"(${service:regex})\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{ span_name }}"
                  }
                }
              }
            }
          ]
        }
      },
      "1_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Error Rate by Span Name"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "minStep": "",
                    "query": "sum by (span_name) (rate(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\", service_name=~\"(${service:regex})\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{ span_name }}"
                  }
                }
              }
            }
          ]
        }
      },
      "1_2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Average Duration by Span Name"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "milliseconds"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "query": "histogram_quantile(0.50, sum(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"(${service:regex})\"}[$__rate_interval])) by (le, span_name))",
                    "seriesNameFormat": "{{span_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "2_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Log Records by Severity"
          },
          "plugin": {
            "kind": "LogsTable",
            "spec": {
              "showTime": false,
              "enableDetails": true,
              "allowWrap": true
            }
          },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "plugin": {
                  "kind": "OpenSearchLogQuery",
                  "spec": {
                    "query": "search source=otel-logs-*\n| where resource.service.name in (${service:singlequote})\n| where (traceId=\"${traceId}\" or \"${traceId}\" = \"\")\n| stats count() by severity.text",
                    "timestampField": "observedTimestamp",
                    "messageField": "body"
                  }
                }
              }
            }
          ]
        }
      },
      "2_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Log Records (100 recent entries)"
          },
          "plugin": {
            "kind": "LogsTable",
            "spec": {
              "showTime": true,
              "enableDetails": true,
              "allowWrap": true
            }
          },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "plugin": {
                  "kind": "OpenSearchLogQuery",
                  "spec": {
                    "query": "search source=otel-logs-*\n| where resource.service.name in (${service:singlequote})\n| where (traceId=\"${traceId}\" or \"${traceId}\" = \"\")\n| sort - observedTimestamp\n| head 100",
                    "timestampField": "observedTimestamp",
                    "messageField": "body"
                  }
                }
              }
            }
          ]
        }
      },
      "3_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Python services (CPU%)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "minStep": "2m",
                    "query": "rate(process_runtime_cpython_cpu_time_seconds_total{type=~\"system\"}[$__rate_interval])*100",
                    "seriesNameFormat": "{{job}} ({{type}})"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "minStep": "2m",
                    "query": "rate(process_runtime_cpython_cpu_time_seconds_total{type=~\"user\"}[$__rate_interval])*100",
                    "seriesNameFormat": "{{job}} ({{type}})"
                  }
                }
              }
            }
          ]
        }
      },
      "3_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Python services (Memory)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "bytes"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "query": "process_runtime_cpython_memory_bytes{type=\"rss\"}",
                    "seriesNameFormat": "{{job}}"
                  }
                }
              }
            }
          ]
        }
      },
      "3_2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Recommendations Rate"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "minStep": "2m",
                    "query": "rate(demo_recommendation_requests_total{recommendation_type=\"catalog\"}[$__rate_interval])",
                    "seriesNameFormat": "recommendations"
                  }
                }
              }
            }
          ]
        }
      },
      "3_3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Quote Service batch span processor"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "minStep": "2m",
                    "query": "rate(otel_trace_span_processor_spans{job=\"quote\"}[2m])*120",
                    "seriesNameFormat": "{{state}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/0"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Spanmetrics (RED metrics)",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 4,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/1_0"
              }
            },
            {
              "x": 8,
              "y": 4,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/1_1"
              }
            },
            {
              "x": 16,
              "y": 4,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/1_2"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Application Log Records",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 13,
              "width": 4,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/2_0"
              }
            },
            {
              "x": 4,
              "y": 13,
              "width": 20,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/2_1"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Application Metrics",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 22,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/3_0"
              }
            },
            {
              "x": 12,
              "y": 22,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/3_1"
              }
            },
            {
              "x": 0,
              "y": 30,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/3_2"
              }
            },
            {
              "x": 12,
              "y": 30,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/3_3"
              }
            }
          ]
        }
      }
    ],
    "duration": "15m"
  }
}

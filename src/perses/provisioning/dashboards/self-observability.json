      "3_2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Metric collect duration (avg)",
            "description": "Average duration of the metric reader's collect step (`otel.sdk.metric_reader.collection.duration`). This is metric-pipeline specific. Shown as an average (sum/count) rather than a percentile because the SDK currently reports this histogram with a single `+Inf` bucket, which makes `histogram_quantile` always return NaN."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "last-number",
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": "${prometheus_datasource}",
                    "query": "sum by (service_name) (rate(otel_sdk_metric_reader_collection_duration_seconds_sum{service_name=~\"$service_name\"}[$__rate_interval])) / sum by (service_name) (rate(otel_sdk_metric_reader_collection_duration_seconds_count{service_name=~\"$service_name\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{service_name}} reader collect"
                  }
                }
              }
            }
          ]
        }
      },
      "3_3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Metric export operation duration (avg)",
            "description": "Average duration of the metric exporter's export call (`otel.sdk.exporter.operation.duration`, filtered to metric exporters), if the SDK reports it. Distinct from \"Metric collect duration\" (the reader's collect step) and from \"Metric data points exported error rate\" (success/failure, not latency). Shown as an average (sum/count) rather than a percentile because the SDK currently reports this histogram with a single `+Inf` bucket, which makes `histogram_quantile` always return NaN."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "last-number",
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "display": "line",
                "lineWidth": 1
              },
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": "${prometheus_datasource}",
                    "query": "sum by (service_name, otel_component_type) (rate(otel_sdk_exporter_operation_duration_seconds_sum{service_name=~\"$service_name\",otel_component_type=~\".*metric_exporter\"}[$__rate_interval])) / sum by (service_name, otel_component_type) (rate(otel_sdk_exporter_operation_duration_seconds_count{service_name=~\"$service_name\",otel_component_type=~\".*metric_exporter\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{service_name}} {{otel_component_type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "3_4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "SDK components reporting",
            "description": "SDK components (exporters, processors, metric readers) reporting self-observability, per service. Derived from `otel.component.type` / `otel.component.name`."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "columnSettings": [
                {
                  "header": "Service",
                  "name": "service_name"
                },
                {
                  "header": "Component type",
                  "name": "otel_component_type"
                },
                {
                  "header": "Component name",
                  "name": "otel_component_name"
                },
                {
                  "hide": true,
                  "name": "timestamp"
                },
                {
                  "hide": true,
                  "name": "value"
                },
                {
                  "hide": true,
                  "name": "__name__"
                },
                {
                  "hide": true,
                  "name": "job"
                },
                {
                  "hide": true,
                  "name": "instance"
                }
              ],
              "density": "compact"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": "${prometheus_datasource}",
                    "instant": true,
                    "query": "group by (service_name, otel_component_type, otel_component_name) ({__name__=~\"otel_sdk_.+\",otel_component_type!=\"\",service_name=~\"$service_name\"})"
                  }
                }
              }
            }
          ]
        }
      }

{
  "kind": "Dashboard",
  "metadata": {
    "name": "exemplars",
    "project": "opentelemetry-demo"
  },
  "spec": {
    "display": {
      "name": "Cart Service Exemplars"
    },
    "panels": {
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {},
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This dashboard shows the latency histograms of the cart service.<br>\nChart panels may require 5 minutes after the Demo is started before rendering data."
            }
          }
        }
      },
      "1_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GetCart Latency Buckets"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "right"
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "areaOpacity": 0,
                "connectNulls": false,
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "query": "sum by(le) (rate(demo_cart_get_cart_latency_seconds_bucket[$__rate_interval]))",
                    "seriesNameFormat": "le={{le}}"
                  }
                }
              }
            }
          ]
        }
      },
      "1_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "95th Pct Cart GetCart Latency with Exemplars"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "query": "histogram_quantile(0.95, sum by(le) (rate(demo_cart_get_cart_latency_seconds_bucket[$__rate_interval])))",
                    "seriesNameFormat": "p95 GetCart"
                  }
                }
              }
            }
          ]
        }
      },
      "2_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "AddItem Latency Buckets"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "right"
              },
              "visual": {
                "display": "line",
                "lineWidth": 1,
                "areaOpacity": 0,
                "connectNulls": false,
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "query": "sum by(le) (rate(demo_cart_add_item_latency_seconds_bucket[$__rate_interval]))",
                    "seriesNameFormat": "le={{le}}"
                  }
                }
              }
            }
          ]
        }
      },
      "2_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "95th Pct Cart AddItem Latency with Exemplars"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0,
                "connectNulls": false,
                "display": "line",
                "lineWidth": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "webstore-metrics"
                    },
                    "query": "histogram_quantile(0.95, sum by(le) (rate(demo_cart_add_item_latency_seconds_bucket[$__rate_interval])))",
                    "seriesNameFormat": "p95 AddItem"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 2,
              "content": {
                "$ref": "#/spec/panels/0"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "GetCart Exemplars",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 3,
              "width": 24,
              "height": 9,
              "content": {
                "$ref": "#/spec/panels/1_0"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/1_1"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "AddItem Exemplars",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 23,
              "width": 24,
              "height": 9,
              "content": {
                "$ref": "#/spec/panels/2_0"
              }
            },
            {
              "x": 0,
              "y": 32,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/2_1"
              }
            }
          ]
        }
      }
    ],
    "duration": "15m"
  }
}

{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Astronomy Shop agentic services: tool calls made by the agent and MCP services, chat volume from the chatbot UI, and LLM call/token metrics emitted automatically by the Traceloop/langchain instrumentation.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of Astronomy Shop tool calls made by the agent service (direct calls) and the mcp service (proxied calls). Source: demo.tool.calls.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": 0 } ] },
          "unit": "items/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(demo_tool_calls_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "Tool calls",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tool calls",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of chat messages sent from the chatbot UI to the agent service. Source: demo.chatbot.requests.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] },
          "unit": "items/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(demo_chatbot_requests_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "Chatbot requests",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Chatbot requests",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Number of distinct Astronomy Shop tools invoked by the agent/mcp services in the selected time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": 0 } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "count(count by (gen_ai_tool_name) (demo_tool_calls_total{service_name=~\"$service_name\"}))",
          "instant": true,
          "legendFormat": "Tools invoked",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Distinct tools invoked",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of LLM calls completed by the agent/chatbot services, from the langchain instrumentation's gen_ai.client.operation.duration histogram count.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": 0 } ] },
          "unit": "items/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_count{service_name=~\"$service_name\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "LLM calls",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "LLM calls",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "panels": [],
      "title": "Tool calls",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of demo.tool.calls broken down by tool name (gen_ai.tool.name), summed across the agent and mcp services.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } },
          "mappings": [],
          "unit": "items/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (gen_ai_tool_name) (rate(demo_tool_calls_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_tool_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tool call rate by tool",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of demo.tool.calls broken down by the service that recorded it: agent (direct local tool calls) vs mcp (tool calls proxied through MCP).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "items/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name) (rate(demo_tool_calls_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tool call rate by service",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 9,
      "panels": [],
      "title": "Chatbot",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of demo.chatbot.requests: chat messages sent from the chatbot UI to the agent service.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "items/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 10,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name) (rate(demo_chatbot_requests_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Chatbot request rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 11,
      "panels": [],
      "title": "LLM performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of input/output tokens consumed, from the langchain instrumentation's gen_ai.client.token.usage histogram (auto-emitted once a MeterProvider is configured; not a demo-defined metric).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } },
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 12,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_token_type}} tokens/sec",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Token usage rate (input vs output)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "p95 LLM call duration by response model, from the langchain instrumentation's gen_ai.client.operation.duration histogram.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 13,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_response_model) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "legendFormat": "{{gen_ai_response_model}} p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "LLM call duration (p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of completed LLM calls by response model, from the langchain instrumentation's gen_ai.client.operation.duration histogram count.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "items/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 14,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (gen_ai_response_model) (rate(gen_ai_client_operation_duration_seconds_count{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_response_model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "LLM call rate by model",
      "type": "timeseries"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [ "opentelemetry", "agent", "llm" ],
  "templating": {
    "list": [
      {
        "current": { "text": "Prometheus", "value": "webstore-metrics" },
        "description": "OpenTelemetry metrics (Prometheus).",
        "label": "Metrics",
        "name": "prometheus_datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "(?!grafanacloud-usage|grafanacloud-ml-metrics).+",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "text": [ "All" ], "value": [ "$__all" ] },
        "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
        "definition": "label_values({__name__=~\"demo_tool_calls_total|demo_chatbot_requests_total|gen_ai_client_operation_duration_seconds_count\"},service_name)",
        "description": "Agentic services (agent, mcp, chatbot). Any new service emitting these metrics appears here automatically.",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service_name",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values({__name__=~\"demo_tool_calls_total|demo_chatbot_requests_total|gen_ai_client_operation_duration_seconds_count\"},service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Agent Services",
  "uid": "agent-services",
  "version": 1,
  "weekStart": ""
}

{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OpenTelemetry self-observability: internal metrics emitted by the OpenTelemetry SDKs themselves (experimental `otel.sdk.*` semantic conventions). Works for any service that opts in to SDK self-monitoring; new services appear automatically via the Service template variable.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Number of services currently emitting OpenTelemetry SDK self-observability metrics.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": 0 } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "count(group by (service_name) ({__name__=~\"otel_sdk_.+\",service_name=~\"$service_name\"}))",
          "instant": true,
          "legendFormat": "Services",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Services reporting",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of spans successfully handed to exporters across the selected services.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": 0 } ] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(otel_sdk_exporter_span_exported_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "Spans exported",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Spans exported",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of metric data points successfully handed to exporters across the selected services.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": 0 } ] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(otel_sdk_exporter_metric_data_point_exported_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "Data points exported",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Metric data points exported",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of log records successfully handed to exporters across the selected services.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(otel_sdk_exporter_log_exported_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "Logs exported",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Log records exported",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of failed exports across all signals (spans, metrics, logs). A non-zero value indicates the SDK could not export telemetry to the collector/backend.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 0.001 } ] },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(rate(otel_sdk_exporter_span_exported_total{service_name=~\"$service_name\",error_type!=\"\"}[$__rate_interval])) + sum(rate(otel_sdk_exporter_metric_data_point_exported_total{service_name=~\"$service_name\",error_type!=\"\"}[$__rate_interval])) + sum(rate(otel_sdk_exporter_log_exported_total{service_name=~\"$service_name\",error_type!=\"\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "Export errors",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Export errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Telemetry records currently passed to an exporter but not yet exported (in-flight), summed across all signals.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": 0 } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum(otel_sdk_exporter_span_inflight{service_name=~\"$service_name\"}) + sum(otel_sdk_exporter_metric_data_point_inflight{service_name=~\"$service_name\"}) + sum(otel_sdk_exporter_log_inflight{service_name=~\"$service_name\"})",
          "instant": false,
          "legendFormat": "In-flight",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Records in-flight",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "SDK components (exporters, processors, metric readers) reporting self-observability, per service. Derived from `otel.component.type` / `otel.component.name`.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [ { "desc": false, "displayName": "Service" } ]
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "group by (service_name, otel_component_type, otel_component_name) ({__name__=~\"otel_sdk_.+\",otel_component_type!=\"\",service_name=~\"$service_name\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "SDK components reporting",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true },
            "indexByName": { "service_name": 0, "otel_component_type": 1, "otel_component_name": 2 },
            "renameByName": {
              "service_name": "Service",
              "otel_component_type": "Component type",
              "otel_component_name": "Component name"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 20,
      "panels": [],
      "title": "Span pipeline",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of spans started by the SDK (`otel.sdk.span.started`). Includes non-recording spans.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 21,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name) (rate(otel_sdk_span_started_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Spans started rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Number of live (started but not yet ended) recording spans (`otel.sdk.span.live`).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "id": 22,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name) (otel_sdk_span_live{service_name=~\"$service_name\"})",
          "legendFormat": "{{service_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Live spans",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Batch span processor queue utilization: current queue size as a fraction of capacity (`otel.sdk.processor.span.queue.size` / `otel.sdk.processor.span.queue.capacity`). Approaching 100% indicates the SDK is dropping spans.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "id": 23,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name, otel_component_name) (otel_sdk_processor_span_queue_size{service_name=~\"$service_name\"}) / sum by (service_name, otel_component_name) (otel_sdk_processor_span_queue_capacity{service_name=~\"$service_name\"})",
          "legendFormat": "{{service_name}} / {{otel_component_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Span processor queue utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of spans processed by span processors, broken down by `error.type` (empty = success).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } },
          "mappings": [],
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "id": 24,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name, error_type) (rate(otel_sdk_processor_span_processed_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{error_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Spans processed rate (by error type)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of spans exported, broken down by `error.type` (empty = success).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } },
          "mappings": [],
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "id": 25,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name, error_type) (rate(otel_sdk_exporter_span_exported_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{error_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Spans exported rate (by error type)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Spans passed to an exporter but not yet exported (`otel.sdk.exporter.span.inflight`).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "id": 26,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name) (otel_sdk_exporter_span_inflight{service_name=~\"$service_name\"})",
          "legendFormat": "{{service_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Spans in-flight",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 40,
      "panels": [],
      "title": "Metric pipeline",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Rate of metric data points exported, broken down by `error.type` (empty = success).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } },
          "mappings": [],
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
      "id": 41,
      "options": { "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name, error_type) (rate(otel_sdk_exporter_metric_data_point_exported_total{service_name=~\"$service_name\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{error_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Metric data points exported rate (by error type)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "Metric data points passed to an exporter but not yet exported (`otel.sdk.exporter.metric_data_point.inflight`).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 30 },
      "id": 42,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "sum by (service_name) (otel_sdk_exporter_metric_data_point_inflight{service_name=~\"$service_name\"})",
          "legendFormat": "{{service_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Metric data points in-flight",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "description": "p95 duration of the metric reader collect operation (`otel.sdk.metric_reader.collection.duration`) and of exporter operations (`otel.sdk.exporter.operation.duration`).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } },
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
      "id": 43,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(otel_sdk_metric_reader_collection_duration_seconds_bucket{service_name=~\"$service_name\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} reader collect",
          "range": true,

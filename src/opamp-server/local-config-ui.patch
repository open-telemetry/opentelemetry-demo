index 917bc83..a802084 100644
--- a/internal/examples/server/uisrv/ui.go
+++ b/internal/examples/server/uisrv/ui.go
@@ -121,0 +122,25 @@ func sendCustomMessage(w http.ResponseWriter, r *http.Request) {
+func localOrigin(r *http.Request) (string, bool) {
+	origin := r.Header.Get("Origin")
+	if origin == "" {
+		return "", false
+	}
+
+	parsed, err := url.Parse(origin)
+	if err != nil {
+		return "", false
+	}
+
+	switch parsed.Scheme {
+	case "http", "https":
+	default:
+		return "", false
+	}
+
+	switch parsed.Hostname() {
+	case "localhost", "127.0.0.1", "::1":
+		return parsed.Scheme + "://" + parsed.Host, true
+	default:
+		return "", false
+	}
+}
+
@@ -122,0 +148,6 @@ func saveCustomConfigForInstance(w http.ResponseWriter, r *http.Request) {
+	origin, ok := localOrigin(r)
+	if r.Method != http.MethodPost || !ok {
+		w.WriteHeader(http.StatusForbidden)
+		return
+	}
+

-func saveCustomConfigForInstance(w http.ResponseWriter, r *http.Request) {
+func trustedLocalOrigin(r *http.Request) bool {
+	switch r.Header.Get("Origin") {
+	case "http://localhost:8080", "http://127.0.0.1:8080":
+		return true
+	default:
+		return false
+	}
+}
+
+func saveCustomConfigForInstance(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost || !trustedLocalOrigin(r) {
+		w.WriteHeader(http.StatusForbidden)
+		return
+	}

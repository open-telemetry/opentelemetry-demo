# Copy to .env.incident (gitignored) and fill in. Names only here, never real values.

# --- LLM (all required for `python -m oncall.llm --check` to pass) ---
LLM_PROVIDER=        # anthropic | openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=        # optional: only for OpenAI-compatible servers

# --- Backends (all optional; defaults are shown in tools/endpoints.py) ---
PROMETHEUS_URL=      # default http://localhost:9090
JAEGER_URL=          # default http://localhost:8080/jaeger/ui (queried at <JAEGER_URL>/api/v3/...)
OPENSEARCH_URL=      # default: found at startup with `docker port opensearch 9200`
OPENSEARCH_CONTAINER=  # default opensearch
COMPOSE_PROJECT=     # default opentelemetry-demo

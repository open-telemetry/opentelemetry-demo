{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: [
    'Notes live in description fields because Renovate removes comments when it migrates this file.',
    'ignorePaths is set because the default preset ignores every test and tests directory, which would skip test/telemetry and src/cart/tests.',
    'requirements.txt files are generated by pip-compile from requirements.in, so only the pip-compile manager handles them.',
    'separateMajorMinor is off so every group is a single pull request, as with the former Dependabot groups.',
    'minimumReleaseAgeBehaviour is timestamp-optional because most container registries publish no release dates; with the default, those image updates would stay pending forever.',
  ],
  extends: [
    'config:best-practices',
    'customManagers:makefileVersions',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  labels: [
    'dependencies',
  ],
  semanticCommits: 'enabled',
  schedule: [
    '* 0-5 * * 2',
  ],
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  prHourlyLimit: 0,
  prConcurrentLimit: 30,
  separateMajorMinor: false,
  ignorePaths: [
    '**/node_modules/**',
    'kubernetes/**',
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      '* 0-5 * * 2',
    ],
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'dependencies',
      'security',
    ],
  },
  osvVulnerabilityAlerts: true,
  postUpdateOptions: [
    'gomodTidyAll',
    'gomodUpdateImportPaths',
  ],
  'pip-compile': {
    managerFilePatterns: [
      '/(^|/)requirements\\.txt$/',
    ],
  },
  pip_requirements: {
    enabled: false,
  },
  customManagers: [
    {
      customType: 'regex',
      description: [
        'Container images in .env.',
        'The pattern matches lines like GRAFANA_IMAGE=grafana/grafana:13.2.1: a variable name ending in _IMAGE, then image name and tag separated by a colon.',
      ],
      managerFilePatterns: [
        '/^\\.env$/',
      ],
      matchStrings: [
        '[A-Z_]+_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: [
        'Annotated versions in .env.',
        'The pattern matches a "# renovate: datasource=... depName=..." comment (with optional packageName and extractVersion) followed by a NAME_VERSION=value line.',
      ],
      managerFilePatterns: [
        '/^\\.env$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[A-Z_]+_VERSION=(?<currentValue>\\S+)',
      ],
    },
    {
      customType: 'regex',
      description: [
        'opamp-go commit pinned in .env.',
        'The pattern matches OPAMP_GO_REF= followed by a 40 character commit SHA.',
      ],
      managerFilePatterns: [
        '/^\\.env$/',
      ],
      matchStrings: [
        'OPAMP_GO_REF=(?<currentDigest>[a-f0-9]{40})',
      ],
      depNameTemplate: 'open-telemetry/opamp-go',
      packageNameTemplate: 'https://github.com/open-telemetry/opamp-go',
      datasourceTemplate: 'git-refs',
      currentValueTemplate: 'main',
    },
    {
      customType: 'regex',
      description: [
        'Go version passed to the shared changelog workflow (setup-go inputs are handled natively).',
        'The pattern matches go-version: followed by a three part version with single, double or no quotes.',
      ],
      managerFilePatterns: [
        '/^\\.github/workflows/changelog\\.yml$/',
      ],
      matchStrings: [
        'go-version:\\s*[\'"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\'"]?',
      ],
      depNameTemplate: 'go',
      datasourceTemplate: 'golang-version',
    },
  ],
  packageRules: [
    {
      description: 'Update indirect Go modules as well',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'indirect',
      ],
      abandonmentThreshold: '50 years',
      enabled: true,
    },
    {
      matchDepTypes: ["indirect", "replace"],
      matchUpdateTypes: [
        'major'
      ],
      matchCategories: [
        'golang',
      ],
      enabled: false,
    },
    {
      description: 'Images in .env are referenced by tag only',
      matchFileNames: [
        '.env',
      ],
      pinDigests: false,
    },
    {
      matchFileNames: [
        '.github/**',
      ],
      groupName: 'github-actions',
    },
    {
      matchFileNames: [
        'package.json',
        'package-lock.json',
        'internal/tools/**',
        'Makefile',
      ],
      groupName: 'repo-tools',
    },
    {
      matchFileNames: [
        '.env',
      ],
      groupName: 'env-images-and-versions',
    },
    {
      matchFileNames: [
        'test/telemetry/**',
      ],
      groupName: 'test-telemetry',
    },
    {
      matchFileNames: ['src/**/*'],
      groupName: 'src-{{parentDir}}',
    },
    {
      description: 'Nuget need dedicated rule as dependencies aren't always in root',
      matchFileNames: ['src/cart/**'],
      groupName: 'src-cart',
    },
    {
      matchFileNames: ['src/accounting/**'],
      groupName: 'src-accounting',
    },
    {
      description: 'Separate major and minor for the json gem so minor stays in the service group and major goes through approval with the next rule',
      matchManagers: [
        'bundler',
      ],
      matchFileNames: [
        'src/react-native-app/**',
      ],
      matchPackageNames: [
        'json',
      ],
      separateMajorMinor: true,
    },
    {
      description: 'Major updates of the json gem in the React Native app need approval on the Dependency Dashboard',
      matchManagers: [
        'bundler',
      ],
      matchFileNames: [
        'src/react-native-app/**',
      ],
      matchPackageNames: [
        'json',
      ],
      matchUpdateTypes: [
        'major',
      ],
      groupName: null,
      dependencyDashboardApproval: true,
    },
    {
      description: 'npm 12 needs a newer Node than the React Native Android build image ships',
      matchFileNames: [
        'src/react-native-app/package.json',
      ],
      matchDepTypes: [
        'packageManager',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      description: 'Refresh all lock files in one pull request instead of one per group',
      matchUpdateTypes: [
        'lockFileMaintenance',
      ],
      groupName: null,
    },
  ],
}

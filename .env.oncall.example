# On-Call Engineer configuration example
# Copy to .env.oncall or pass via docker-compose / environment variables.
# Do NOT edit upstream .env or .env.override.

# Shared HMAC secret for Action API approval tokens
ACTION_API_SECRET=change-me-locally

# LLM Configuration (Ollama on host)
ONCALL_LLM_BASE_URL=http://host.docker.internal:11434/v1
ONCALL_LLM_MODEL=qwen2.5:7b-instruct
ONCALL_LLM_API_KEY=ollama
ONCALL_LLM_NUM_CTX=8192
ONCALL_LLM_TIMEOUT_S=180

# Agent Investigation & Diagnostic Controls
ONCALL_MAX_STEPS=12
ONCALL_MAX_ROUNDS=3
ONCALL_CONFIDENCE_THRESHOLD=0.70
ONCALL_POLL_INTERVAL_S=30
ONCALL_SETTLE_S=120
ONCALL_APPROVAL_TTL_S=900
ONCALL_DRY_RUN_DEFAULT=true

# Evaluation Harness Controls
EVAL_AUTO_APPROVE=false

# Service URLs (defaults inside docker-compose network)
ONCALL_PROMETHEUS_URL=http://prometheus:9090
ONCALL_JAEGER_URL=http://jaeger:16686
ONCALL_OPENSEARCH_URL=http://opensearch:9200
ONCALL_FLAGD_UI_URL=http://flagd-ui:4000
ONCALL_LOAD_GENERATOR_URL=http://load-generator:8089
ONCALL_ACTION_API_URL=http://action-api:8201

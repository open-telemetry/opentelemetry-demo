# ==============================================================================
# Bosch Incident Zero - Environment Configuration Template
# Safe placeholders only. Never commit production credentials or API keys.
# ==============================================================================

# General Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Safety Controls
KILL_SWITCH_ENABLED=false
KILL_SWITCH_FILE=./.kill_switch
REQUIRE_HUMAN_APPROVAL=true
DRY_RUN_MODE=true

# Observability Backend Endpoints (Local Demo defaults)
JAEGER_URL=http://localhost:8080
PROMETHEUS_URL=http://localhost:9090
# Leave OPENSEARCH_URL empty to discover its random host port via `docker port opensearch 9200`.
OPENSEARCH_URL=
FRONTEND_PROXY_URL=http://localhost:8080

# Fault Injection Controls
FAULTCTL_BINARY_PATH=

# Action API Configuration
ACTION_API_ENDPOINT=http://localhost:8080/action-api
ACTION_API_TIMEOUT_SECONDS=10

# Audit Logging & Storage
AUDIT_LOG_PATH=./audit_logs/audit.jsonl
REPORT_OUTPUT_DIR=./incident_output

# LLM / Reasoning Provider (required: without a provider and key the agent exits with code 2)
# LLM_PROVIDER: anthropic | openai | gemini | openrouter | openai_compatible (needs LLM_BASE_URL)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# OpenAI-style providers: tried in order only on 402/404/408/429/5xx/timeouts, never on bad model output.
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free
# Optional second provider (Google AI Studio free tier) tried after every OpenRouter model fails at transport level.
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODELS_2=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite

# OpenRouter through its OpenAI-compatible endpoint. Put the real key only in the git-ignored .env.
#LLM_PROVIDER=openai_compatible
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#LLM_API_KEY=<openrouter key>
# OpenRouter reserves credit for the whole output cap; lower this if requests fail with 402.
#LLM_MAX_TOKENS=4096
# Optional OpenRouter app attribution headers (HTTP-Referer and X-Title)
#LLM_HTTP_REFERER=https://github.com/<org>/team8-otel-demo
#LLM_APP_TITLE=Bosch Incident Zero

# copy to .env and fill in.  NEVER commit .env (it is in .gitignore).
# --- LLM: any OpenAI-compatible endpoint ---
LLM_API_KEY=your-key-here
# models tried in order if the main one is overloaded / not found / times out
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
LLM_REASONING_EFFORT=low
# Groq:
LLM_BASE_URL=https://api.groq.com/openai/v1/
LLM_MODEL=llama-3.3-70b-versatile
MAX_TOOL_CALLS=10
# Gemini instead:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# local alternative: LLM_BASE_URL=http://localhost:11434/v1/  LLM_MODEL=qwen2.5:7b  (no key)

# --- telemetry (read-only) ---
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui
OPENSEARCH_URL=
WINDOW=5m
BASELINE_OFFSET=30m

# --- Action API (ours: python -m action_api) ---
ACTION_API_URL=http://localhost:8000
ACTION_API_TOKEN=
ACTION_API_MODE=http
# server side (optional - defaults work with docker compose on localhost)
ACTION_API_PORT=8000
PLATFORM=docker
# OTEL_DEMO_DIR=/path/to/opentelemetry-demo      # only if the flag file is not auto-discovered
# FLAGD_FILE=/path/to/opentelemetry-demo/src/flagd/demo.flagd.json
LOADGEN_URL=http://localhost:8080/loadgen
FLAGD_UI_URL=http://localhost:8080/feature

# --- policy ---
CONFIDENCE_TO_ACT=0.6
VERIFY_SECONDS=240
VERIFY_WINDOW=1m
POLL_SECONDS=20
ALERT_CONSECUTIVE=2
